{
  "name": "ai-diff-agent",
  "displayName": "AI Diff Agent",
  "description": "Agentic Diff Engine for LLM code application with Human-in-the-loop control.",
  "version": "0.2.0",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ai-diff-agent-sidebar-container",
          "title": "AI Diff Agent",
          "icon": "$(hubot)"
        }
      ]
    },
    "views": {
      "ai-diff-agent-sidebar-container": [
        {
          "type": "webview",
          "id": "ai-diff-agent-sidebar-view",
          "name": "Chat",
          "icon": "robot"
        }
      ]
    },
    "commands": [
      {
        "command": "ai-diff-agent.start",
        "title": "AI Diff Agent: Focus Chat"
      },
      {
        "command": "ai-diff-agent.action.acceptAll",
        "title": "AI Diff Agent: Accept All Pending Changes"
      },
      {
        "command": "ai-diff-agent.action.rejectAll",
        "title": "AI Diff Agent: Reject All Pending Changes"
      },
      {
        "command": "ai-diff-agent.showLog",
        "title": "AI Diff Agent: Show Output Log"
      }
    ],
    "keybindings": [
      {
        "command": "ai-diff-agent.action.acceptAll",
        "key": "ctrl+shift+a",
        "mac": "cmd+shift+a",
        "when": "view.ai-diff-agent-sidebar-view.visible"
      },
      {
        "command": "ai-diff-agent.action.rejectAll",
        "key": "ctrl+shift+r",
        "mac": "cmd+shift+r",
        "when": "view.ai-diff-agent-sidebar-view.visible"
      }
    ],
    "configuration": {
      "title": "AI Diff Agent",
      "properties": {
        "aiDiffAgent.ui": {
          "type": "object",
          "description": "UI and Display settings",
          "properties": {
            "autoScroll": { "type": "boolean", "default": true },
            "compactMode": { "type": "boolean", "default": false },
            "showConfidenceBadges": { "type": "boolean", "default": true },
            "enableCodeLens": { "type": "boolean", "default": true, "description": "Enable clickable [Accept Block] and [Reject Block] CodeLens buttons directly inside the text editor." }
          },
          "default": {
            "autoScroll": true,
            "compactMode": false,
            "showConfidenceBadges": true,
            "enableCodeLens": true
          }
        },
        "aiDiffAgent.workflow": {
          "type": "object",
          "description": "Lifecycle and automation settings",
          "properties": {
            "chatHistoryMode": { "type": "string", "enum": ["workspace", "global", "disabled"], "default": "workspace" },
            "autoSaveAfterAccept": { "type": "boolean", "default": true },
            "formatBehavior": { "type": "string", "enum": ["always", "onSaveOnly", "never"], "default": "onSaveOnly" },
            "cleanupEmptyDirectories": { "type": "boolean", "default": true },
            "backupRetentionDays": { "type": "number", "default": 7 }
          },
          "default": {
            "chatHistoryMode": "workspace",
            "autoSaveAfterAccept": true,
            "formatBehavior": "onSaveOnly",
            "cleanupEmptyDirectories": true,
            "backupRetentionDays": 7
          }
        },
        "aiDiffAgent.engine": {
          "type": "object",
          "description": "Diff Engine and parsing settings",
          "properties": {
            "payloadRecoveryMode": { "type": "string", "enum": ["strict", "standard", "aggressive"], "default": "aggressive", "description": "Controls how aggressively the parser tries to salvage malformed XML/Code wrappers." },
            "fallbackMatchLevel": { "type": "string", "enum": ["none", "safe", "aggressive"], "default": "safe", "description": "Determines how the engine searches for code if AST fails." },
            "enableAstMatching": { "type": "boolean", "default": true, "description": "Enable structural Abstract Syntax Tree (AST) matching for highly resilient code replacement." },
            "strictSyntaxValidation": { "type": "boolean", "default": false, "description": "If true, strictly blocks the transaction if the AI introduces syntax errors (missing brackets, semicolons)." },
            "autoFixSyntax": { "type": "boolean", "default": true },
            "maxFileSizeMb": { "type": "number", "default": 5 }
          },
          "default": {
            "payloadRecoveryMode": "aggressive",
            "fallbackMatchLevel": "safe",
            "enableAstMatching": true,
            "strictSyntaxValidation": false,
            "autoFixSyntax": true,
            "maxFileSizeMb": 5
          }
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build:webview": "vite build",
    "build:extension": "npx esbuild src/extension/extension.ts --bundle --platform=node --target=node16 --external:vscode --outfile=out/extension/extension.js --sourcemap && node scripts/copy-wasm.js",
    "build": "npm run build:webview && npm run build:extension",
    "watch:webview": "vite build --watch",
    "watch:extension": "node scripts/copy-wasm.js && npx esbuild src/extension/extension.ts --bundle --platform=node --target=node16 --external:vscode --outfile=out/extension/extension.js --sourcemap --watch",
    "lint": "eslint src --ext ts,tsx",
    "test": "mocha -r ts-node/register -r tests/setup.ts tests/**/*.spec.ts"
  },
  "dependencies": {
    "@tabler/icons-react": "^3.44.0",
    "@vscode/webview-ui-toolkit": "^1.4.0",
    "react": "^19.x",
    "react-dom": "^19.x",
    "web-tree-sitter": "^0.26.9",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.0.1",
    "@types/react": "^19.x",
    "@types/react-dom": "^19.x",
    "@types/vscode": "^1.x",
    "@vitejs/plugin-react-swc": "^4.3.1",
    "esbuild": "^0.28.1",
    "mocha": "^11.7.6",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "vite": "^8.0.0"
  }
}